<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vac_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vac_txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vac_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <EditText android:id="@+id/vac_txt_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
        <EditText android:id="@+id/vac_txt_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
        <EditText android:id="@+id/vac_txt_first_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
        <EditText android:id="@+id/vac_txt_last_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
        <EditText android:id="@+id/vac_txt_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="8" />
        <EditText android:id="@+id/vac_txt_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
        <EditText android:id="@+id/vac_txt_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" />

        <TextView android:id="@+id/vac_lbl_vaccine_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <Spinner android:id="@+id/vac_spn_vaccine_type" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:id="@+id/vac_lbl_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <Spinner android:id="@+id/vac_spn_location" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:id="@+id/vac_lbl_date_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/vac_txt_date_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="datetime" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button android:id="@+id/vac_btn_save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/TextSave" />
            <Button android:id="@+id/vac_btn_delete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/TextDelete" />
            <Button android:id="@+id/vac_btn_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/TextCancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
